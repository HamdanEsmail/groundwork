{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundwork",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groundwork",
      "database_id": "7b6decaf-08bb-4dde-9acc-dd0b348216fc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORE",
      "bucket_name": "groundwork"
    }
  ],
  "workflows": [
    {
      "name": "groundwork-agent-sections",
      "binding": "DOSSIER_WORKFLOW",
      "class_name": "DossierAgentWorkflow"
    }
  ],
  "triggers": {
    "crons": ["30 * * * *"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://groundwork.hamdanesmail12-7a9.workers.dev"
  },
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
